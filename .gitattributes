# ─────────────────────────────────────────────────────────────
#  Line ending normalization
#  Everything Git detects as text is stored LF in the repo and
#  checked out LF on every platform. Overrides core.autocrlf.
# ─────────────────────────────────────────────────────────────
* text=auto eol=lf

# ─────────────────────────────────────────────────────────────
#  Explicit text types (belt and braces)
# ─────────────────────────────────────────────────────────────
*.html    text eol=lf
*.htm     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.webmanifest text eol=lf
*.sh      text eol=lf
*.env     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-only files genuinely need CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ─────────────────────────────────────────────────────────────
#  Binary — never touch these
# ─────────────────────────────────────────────────────────────
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.avif    binary
*.ico     binary
*.bmp     binary
*.psd     binary
*.pdf     binary

*.mp4     binary
*.webm    binary
*.mov     binary
*.mp3     binary
*.ogg     binary
*.wav     binary
*.m4a     binary

*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.eot     binary

*.zip     binary
*.gz      binary
*.tar     binary
*.7z      binary
*.rar     binary

# ─────────────────────────────────────────────────────────────
#  Android / signing artifacts (if this repo ever holds them)
# ─────────────────────────────────────────────────────────────
*.keystore binary
*.jks      binary
*.apk      binary
*.aab      binary
*.jar      binary
*.aar      binary
*.so       binary
*.dex      binary
gradlew    text eol=lf
gradlew.bat text eol=crlf

# ─────────────────────────────────────────────────────────────
#  Diff hygiene — collapse noisy generated files in PR views
# ─────────────────────────────────────────────────────────────
package-lock.json linguist-generated=true -diff
yarn.lock         linguist-generated=true -diff
pnpm-lock.yaml    linguist-generated=true -diff
