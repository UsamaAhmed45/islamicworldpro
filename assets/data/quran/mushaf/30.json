{"581":[[77,20,"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٍ مَّهِينٍ",29],[77,21,"فَجَعَلۡنَٰهُ فِي قَرَارٍ مَّكِينٍ",29],[77,22,"إِلَىٰ قَدَرٍ مَّعۡلُومٍ",29],[77,23,"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ",29],[77,24,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,25,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",29],[77,26,"أَحۡيَآءً وَأَمۡوَٰتً ا",29],[77,27,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٍ وَأَسۡقَيۡنَٰكُم مَّآءً فُرَاتً ا",29],[77,28,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,29,"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",29],[77,30,"ٱنطَلِقُوٓاْ إِلَىٰ ظِلٍّ ذِي ثَلَٰثِ شُعَبٍ",29],[77,31,"لَّا ظَلِيلٍ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ",29],[77,32,"إِنَّهَا تَرۡمِي بِشَرَرٍ كَٱلۡقَصۡرِ",29],[77,33,"كَأَنَّهُۥ جِمَٰلَتٌ صُفۡرٌ",29],[77,34,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,35,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ",29],[77,36,"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ",29],[77,37,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,38,"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ",29],[77,39,"فَإِن كَانَ لَكُمۡ كَيۡدٌ فَكِيدُونِ",29],[77,40,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,41,"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٍ وَعُيُونٍ",29],[77,42,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ",29],[77,43,"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",29],[77,44,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",29],[77,45,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,46,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ",29],[77,47,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,48,"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ",29],[77,49,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",29],[77,50,"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ",29]],"582":[[78,1,"عَمَّ يَتَسَآءَلُونَ",30],[78,2,"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ",30],[78,3,"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ",30],[78,4,"كَلَّا سَيَعۡلَمُونَ",30],[78,5,"ثُمَّ كَلَّا سَيَعۡلَمُونَ",30],[78,6,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدً ا",30],[78,7,"وَٱلۡجِبَالَ أَوۡتَادً ا",30],[78,8,"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجً ا",30],[78,9,"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتً ا",30],[78,10,"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسً ا",30],[78,11,"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشً ا",30],[78,12,"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعً ا شِدَادً ا",30],[78,13,"وَجَعَلۡنَا سِرَاجً ا وَهَّاجً ا",30],[78,14,"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءً ثَجَّاجً ا",30],[78,15,"لِّنُخۡرِجَ بِهِۦ حَبًّ ا وَنَبَاتً ا",30],[78,16,"وَجَنَّٰتٍ أَلۡفَافًا",30],[78,17,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتً ا",30],[78,18,"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجً ا",30],[78,19,"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبً ا",30],[78,20,"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",30],[78,21,"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادً ا",30],[78,22,"لِّلطَّٰغِينَ مَـَٔابً ا",30],[78,23,"لَّٰبِثِينَ فِيهَآ أَحۡقَابً ا",30],[78,24,"لَّا يَذُوقُونَ فِيهَا بَرۡدً ا وَلَا شَرَابًا",30],[78,25,"إِلَّا حَمِيمً ا وَغَسَّاقً ا",30],[78,26,"جَزَآءً وِفَاقًا",30],[78,27,"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابً ا",30],[78,28,"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابً ا",30],[78,29,"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبً ا",30],[78,30,"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا",30]],"583":[[78,31,"إِنَّ لِلۡمُتَّقِينَ مَفَازًا",30],[78,32,"حَدَآئِقَ وَأَعۡنَٰبً ا",30],[78,33,"وَكَوَاعِبَ أَتۡرَابً ا",30],[78,34,"وَكَأۡسً ا دِهَاقً ا",30],[78,35,"لَّا يَسۡمَعُونَ فِيهَا لَغۡوً ا وَلَا كِذَّٰبً ا",30],[78,36,"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابً ا",30],[78,37,"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابً ا",30],[78,38,"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفًّ اۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابً ا",30],[78,39,"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",30],[78,40,"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابً ا قَرِيبً ا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا",30],[79,1,"وَٱلنَّٰزِعَٰتِ غَرۡقً ا",30],[79,2,"وَٱلنَّٰشِطَٰتِ نَشۡطً ا",30],[79,3,"وَٱلسَّٰبِحَٰتِ سَبۡحً ا",30],[79,4,"فَٱلسَّٰبِقَٰتِ سَبۡقً ا",30],[79,5,"فَٱلۡمُدَبِّرَٰتِ أَمۡرً ا",30],[79,6,"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ",30],[79,7,"تَتۡبَعُهَا ٱلرَّادِفَةُ",30],[79,8,"قُلُوبٌ يَوۡمَئِذٍ وَاجِفَةٌ",30],[79,9,"أَبۡصَٰرُهَا خَٰشِعَةٌ",30],[79,10,"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ",30],[79,11,"أَءِذَا كُنَّا عِظَٰمً ا نَّخِرَةً",30],[79,12,"قَالُواْ تِلۡكَ إِذً ا كَرَّةٌ خَاسِرَةٌ",30],[79,13,"فَإِنَّمَا هِيَ زَجۡرَةٌ وَٰحِدَةٌ",30],[79,14,"فَإِذَا هُم بِٱلسَّاهِرَةِ",30],[79,15,"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",30]],"584":[[79,16,"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى",30],[79,17,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",30],[79,18,"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",30],[79,19,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ",30],[79,20,"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ",30],[79,21,"فَكَذَّبَ وَعَصَىٰ",30],[79,22,"ثُمَّ أَدۡبَرَ يَسۡعَىٰ",30],[79,23,"فَحَشَرَ فَنَادَىٰ",30],[79,24,"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ",30],[79,25,"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ",30],[79,26,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةً لِّمَن يَخۡشَىٰٓ",30],[79,27,"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا",30],[79,28,"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا",30],[79,29,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا",30],[79,30,"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ",30],[79,31,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا",30],[79,32,"وَٱلۡجِبَالَ أَرۡسَىٰهَا",30],[79,33,"مَتَٰعً ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",30],[79,34,"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ",30],[79,35,"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ",30],[79,36,"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ",30],[79,37,"فَأَمَّا مَن طَغَىٰ",30],[79,38,"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",30],[79,39,"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ",30],[79,40,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ",30],[79,41,"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ",30],[79,42,"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا",30],[79,43,"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ",30],[79,44,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",30],[79,45,"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا",30],[79,46,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا",30]],"585":[[80,1,"عَبَسَ وَتَوَلَّىٰٓ",30],[80,2,"أَن جَآءَهُ ٱلۡأَعۡمَىٰ",30],[80,3,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",30],[80,4,"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",30],[80,5,"أَمَّا مَنِ ٱسۡتَغۡنَىٰ",30],[80,6,"فَأَنتَ لَهُۥ تَصَدَّىٰ",30],[80,7,"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",30],[80,8,"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",30],[80,9,"وَهُوَ يَخۡشَىٰ",30],[80,10,"فَأَنتَ عَنۡهُ تَلَهَّىٰ",30],[80,11,"كَلَّآ إِنَّهَا تَذۡكِرَةٌ",30],[80,12,"فَمَن شَآءَ ذَكَرَهُۥ",30],[80,13,"فِي صُحُفٍ مُّكَرَّمَةٍ",30],[80,14,"مَّرۡفُوعَةٍ مُّطَهَّرَةِۭ",30],[80,15,"بِأَيۡدِي سَفَرَةٍ",30],[80,16,"كِرَامِۭ بَرَرَةٍ",30],[80,17,"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",30],[80,18,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",30],[80,19,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",30],[80,20,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",30],[80,21,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",30],[80,22,"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",30],[80,23,"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",30],[80,24,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",30],[80,25,"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبًّ ا",30],[80,26,"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقًّ ا",30],[80,27,"فَأَنۢبَتۡنَا فِيهَا حَبًّ ا",30],[80,28,"وَعِنَبً ا وَقَضۡبً ا",30],[80,29,"وَزَيۡتُونً ا وَنَخۡلً ا",30],[80,30,"وَحَدَآئِقَ غُلۡبً ا",30],[80,31,"وَفَٰكِهَةً وَأَبًّ ا",30],[80,32,"مَّتَٰعً ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",30],[80,33,"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",30],[80,34,"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",30],[80,35,"وَأُمِّهِۦ وَأَبِيهِ",30],[80,36,"وَصَٰحِبَتِهِۦ وَبَنِيهِ",30],[80,37,"لِكُلِّ ٱمۡرِيٍٕ مِّنۡهُمۡ يَوۡمَئِذٍ شَأۡنٌ يُغۡنِيهِ",30],[80,38,"وُجُوهٌ يَوۡمَئِذٍ مُّسۡفِرَةٌ",30],[80,39,"ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌ",30],[80,40,"وَوُجُوهٌ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٌ",30],[80,41,"تَرۡهَقُهَا قَتَرَةٌ",30],[80,42,"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",30]],"586":[[81,1,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",30],[81,2,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",30],[81,3,"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",30],[81,4,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",30],[81,5,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",30],[81,6,"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",30],[81,7,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",30],[81,8,"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",30],[81,9,"بِأَيِّ ذَنۢبٍ قُتِلَتۡ",30],[81,10,"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",30],[81,11,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",30],[81,12,"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",30],[81,13,"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",30],[81,14,"عَلِمَتۡ نَفۡسٌ مَّآ أَحۡضَرَتۡ",30],[81,15,"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",30],[81,16,"ٱلۡجَوَارِ ٱلۡكُنَّسِ",30],[81,17,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ",30],[81,18,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",30],[81,19,"إِنَّهُۥ لَقَوۡلُ رَسُولٍ كَرِيمٍ",30],[81,20,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٍ",30],[81,21,"مُّطَاعٍ ثَمَّ أَمِينٍ",30],[81,22,"وَمَا صَاحِبُكُم بِمَجۡنُونٍ",30],[81,23,"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",30],[81,24,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٍ",30],[81,25,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٍ رَّجِيمٍ",30],[81,26,"فَأَيۡنَ تَذۡهَبُونَ",30],[81,27,"إِنۡ هُوَ إِلَّا ذِكۡرٌ لِّلۡعَٰلَمِينَ",30],[81,28,"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",30],[81,29,"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",30]],"587":[[82,1,"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",30],[82,2,"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",30],[82,3,"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",30],[82,4,"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",30],[82,5,"عَلِمَتۡ نَفۡسٌ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",30],[82,6,"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",30],[82,7,"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",30],[82,8,"فِيٓ أَيِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",30],[82,9,"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",30],[82,10,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",30],[82,11,"كِرَامً ا كَٰتِبِينَ",30],[82,12,"يَعۡلَمُونَ مَا تَفۡعَلُونَ",30],[82,13,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ",30],[82,14,"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٍ",30],[82,15,"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",30],[82,16,"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ",30],[82,17,"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",30],[82,18,"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",30],[82,19,"يَوۡمَ لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـًٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذٍ لِّلَّهِ",30],[83,1,"وَيۡلٌ لِّلۡمُطَفِّفِينَ",30],[83,2,"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ",30],[83,3,"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ",30],[83,4,"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ",30],[83,5,"لِيَوۡمٍ عَظِيمٍ",30],[83,6,"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ",30]],"588":[[83,7,"كَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٍ",30],[83,8,"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٌ",30],[83,9,"كِتَٰبٌ مَّرۡقُومٌ",30],[83,10,"وَيۡلٌ يَوۡمَئِذٍ لِّلۡمُكَذِّبِينَ",30],[83,11,"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ",30],[83,12,"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ",30],[83,13,"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",30],[83,14,"كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ",30],[83,15,"كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٍ لَّمَحۡجُوبُونَ",30],[83,16,"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ",30],[83,17,"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",30],[83,18,"كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ",30],[83,19,"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ",30],[83,20,"كِتَٰبٌ مَّرۡقُومٌ",30],[83,21,"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ",30],[83,22,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ",30],[83,23,"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ",30],[83,24,"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ",30],[83,25,"يُسۡقَوۡنَ مِن رَّحِيقٍ مَّخۡتُومٍ",30],[83,26,"خِتَٰمُهُۥ مِسۡكٌۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ",30],[83,27,"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ",30],[83,28,"عَيۡنً ا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ",30],[83,29,"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ",30],[83,30,"وَإِذَا مَرُّواْ