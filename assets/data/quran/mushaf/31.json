{"601":[[103,1,"وَٱلۡعَصۡرِ",30],[103,2,"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",30],[103,3,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",30],[104,1,"وَيۡلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",30],[104,2,"ٱلَّذِي جَمَعَ مَالً ا وَعَدَّدَهُۥ",30],[104,3,"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",30],[104,4,"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",30],[104,5,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",30],[104,6,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",30],[104,7,"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",30],[104,8,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٌ",30],[104,9,"فِي عَمَدٍ مُّمَدَّدَةِۭ",30],[105,1,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",30],[105,2,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٍ",30],[105,3,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",30],[105,4,"تَرۡمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ",30],[105,5,"فَجَعَلَهُمۡ كَعَصۡفٍ مَّأۡكُولِۭ",30]],"602":[[106,1,"لِإِيلَٰفِ قُرَيۡشٍ",30],[106,2,"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ",30],[106,3,"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",30],[106,4,"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",30],[107,1,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",30],[107,2,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",30],[107,3,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",30],[107,4,"فَوَيۡلٌ لِّلۡمُصَلِّينَ",30],[107,5,"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",30],[107,6,"ٱلَّذِينَ هُمۡ يُرَآءُونَ",30],[107,7,"وَيَمۡنَعُونَ ٱلۡمَاعُونَ",30],[108,1,"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ",30],[108,2,"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ",30],[108,3,"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ",30]],"603":[[109,1,"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ",30],[109,2,"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ",30],[109,3,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",30],[109,4,"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمۡ",30],[109,5,"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ",30],[109,6,"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ",30],[110,1,"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ",30],[110,2,"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجً ا",30],[110,3,"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا",30],[111,1,"تَبَّتۡ يَدَآ أَبِي لَهَبٍ وَتَبَّ",30],[111,2,"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ",30],[111,3,"سَيَصۡلَىٰ نَارً ا ذَاتَ لَهَبٍ",30],[111,4,"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ",30],[111,5,"فِي جِيدِهَا حَبۡلٌ مِّن مَّسَدِۭ",30]],"604":[[112,1,"قُلۡ هُوَ ٱللَّهُ أَحَدٌ",30],[112,2,"ٱللَّهُ ٱلصَّمَدُ",30],[112,3,"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ",30],[112,4,"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ",30],[113,1,"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",30],[113,2,"مِن شَرِّ مَا خَلَقَ",30],[113,3,"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",30],[113,4,"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",30],[113,5,"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",30],[114,1,"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",30],[114,2,"مَلِكِ ٱلنَّاسِ",30],[114,3,"إِلَٰهِ ٱلنَّاسِ",30],[114,4,"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",30],[114,5,"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",30],[114,6,"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",30]]}